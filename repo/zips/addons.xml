<?xml version='1.0' encoding='utf-8'?>
<addons><addon id="plugin.video.watchorder" name="Watch Order" version="0.9.0" provider-name="dkoch84">
    <requires>
        <import addon="xbmc.python" version="3.0.1" />
        <import addon="script.module.myconnpy" version="8.0.18" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="main.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="service.py" />
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Collection-aware TV &amp; movie browser with linked movies, tag filtering, and shared collections</summary>
        <description lang="en_GB">Collection-aware replacement for the standard library browser. Group related TV shows and movies into collections, place linked movies alongside seasons, filter by tag, and sync everything across Kodi installs via MySQL. Respects Kodi settings for flattened seasons, first-unwatched selection, and specials. All collections are managed through context menus.</description>
        <platform>all</platform>
        <license>MIT</license>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon><addon id="repository.dank" name="dank_repository" version="1.0.0" provider-name="dkoch84">
    <extension point="xbmc.addon.repository" name="Example Repository">
        <dir>
            <info compressed="false">https://raw.githubusercontent.com/dkoch84/repository.dkoch84/main/repo/zips/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/dkoch84/repository.dkoch84/main/repo/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/dkoch84/repository.dkoch84/main/repo/zips/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary>dank repo</summary>
        <description>A dank repo for dank addons</description>
        <disclaimer />
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon><addon id="skin.eminence.3" name="Eminence 3" provider-name="dkoch84" version="1.1.0">
